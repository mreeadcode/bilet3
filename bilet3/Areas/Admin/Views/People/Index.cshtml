


@model List<Person>


    @{
        int counter = 0;
    }

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Tables</h1>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">People Table</h6>
            <a asp-action="Create" class="btn btn-primary">Create</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Position</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (Person person in Model)
                            {
                                <tr>
                                    <th>@(++counter)</th>
                                    <th>
                                        <img src="~/assets/images/@person.Image" height="60" width="auto" alt="Alternate Text" />
                                    </th>
                                    <th>@person.Fullname</th>
                                    <th>@person.Designation</th>
                                    <th>
                                        <a asp-action="Update" asp-route-id="@person.Id" class="btn btn-primary">Edit</a>
                                        <a asp-action="Detail" asp-route-id="@person.Id" class="btn btn-success">Detail</a>
                                        <a asp-action="Delete" asp-route-id="@person.Id" class="btn btn-danger">Delete</a>
                                    </th>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
<!-- /.container-fluid -->
</div>
<!-- End of Main Content -->
